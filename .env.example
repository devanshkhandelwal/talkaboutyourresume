# Required
ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=...

# Models (optional, these are the defaults)
# Used to read resumes and write the feedback report.
ANTHROPIC_RESUME_MODEL=claude-haiku-5-5
ANTHROPIC_FEEDBACK_MODEL=claude-sonnet-5-5
# The interviewer's brain inside the Deepgram voice agent.
# claude-haiku-4-5 is billed at Deepgram's Standard tier.
DEEPGRAM_THINK_MODEL=claude-haiku-4-5

# Limits (optional)
MAX_INTERVIEW_MINUTES=15
DAILY_INTERVIEWS_PER_IP=3

# Optional: Upstash Redis (free tier works). Enables per-IP daily limits
# and saves emails from the "Keep your feedback" form.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
